# Copy this file to .env and fill in real values before deploying.

# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database — leave DATABASE_URL unset to use local SQLite.
# For Postgres: postgresql://user:password@host:5432/dbname
DATABASE_URL=

# Email — leave EMAIL_HOST unset to print emails to the console (dev mode).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=vault@locker.app

# Set to True and provide a real domain once behind HTTPS in production.
SECURE_SSL_REDIRECT=False
